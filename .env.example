# Токен від BotFather для запуску Telegram-бота. Для гри в браузері можна лишити порожнім.
POMROK_BOT_KEY=
# Необов’язково. Бот дізнається своє ім’я під час підключення до Telegram.
TELEGRAM_BOT_USERNAME=
WEB_PORT=3000

# Лише для запуску через compose.monitoring.yaml. Задай власний пароль.
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3100

# Лише для запуску через compose.webhook.yaml.
TELEGRAM_WEBHOOK_SECRET=
NGROK_AUTHTOKEN=
